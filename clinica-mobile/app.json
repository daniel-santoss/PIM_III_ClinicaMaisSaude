{
  "expo": {
    "name": "Clínica Mais Saúde",
    "slug": "clinica-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clinicamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.clinicamaissaude.mobile"
    },
    "android": {
      "package": "com.clinicamaissaude.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "name": "Clínica Mais Saúde",
      "shortName": "Mais Saúde",
      "favicon": "./assets/images/favicon.png",
      "lang": "pt-BR",
      "themeColor": "#FFFFFF",
      "description": "Agende e acompanhe suas consultas na Clínica Mais Saúde."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para definir a foto de perfil.",
          "cameraPermission": "O app usa a câmera para tirar sua foto de perfil."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O app usa o Face ID para desbloquear seu acesso."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f2898cc9-791c-4a38-adb7-d293318600ee"
      }
    }
  }
}
