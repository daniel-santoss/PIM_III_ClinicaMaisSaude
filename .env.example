# Copie para .env (gitignored) e preencha. Usado pelo docker-compose.yml.
# NÃO commite o .env preenchido.

# Banco (SQL Server no container)
MSSQL_SA_PASSWORD=Troque_Esta_Senha_Forte_123!

# JWT — chave HMAC com 32+ caracteres (gere uma NOVA, não reuse a de dev)
JWT_SECRET=coloque_uma_chave_secreta_com_32_ou_mais_caracteres

# Admin semeado no 1º boot
ADMIN_EMAIL=admin@clinicamaissaude.com.br
ADMIN_CPF=00000000000
ADMIN_PASSWORD=senha_admin_forte

# Pepper da recuperação de senha (gere: openssl rand -base64 32)
RECUP_PEPPER=gere_um_valor_aleatorio_base64_de_32_bytes

# SMTP (Brevo etc.) — deixe EMAIL_HOST vazio para NÃO enviar (código cai no log)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=xxxxxxx@smtp-brevo.com
EMAIL_PASSWORD=sua_smtp_key
EMAIL_FROM=seu-remetente-verificado@dominio.com
EMAIL_FROM_NAME=Clínica Mais Saúde
EMAIL_LOGO_URL=

# IA (Gemini)
GEMINI_API_KEY=sua_chave_gemini

# Origem do front-end (CORS)
FRONTEND_ORIGIN=http://localhost:5173
